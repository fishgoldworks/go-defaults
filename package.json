{
  "name": "@fishgold/go-js",
  "version": "0.1.0",
  "description": "Small dependency-free JavaScript helpers.",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./wait": {
      "types": {
        "import": "./dist/wait.d.mts",
        "require": "./dist/wait.d.cts",
        "default": "./dist/wait.d.cts"
      },
      "import": "./dist/wait.mjs",
      "require": "./dist/wait.cjs",
      "default": "./dist/wait.cjs"
    },
    "./result": {
      "types": {
        "import": "./dist/result.d.mts",
        "require": "./dist/result.d.cts",
        "default": "./dist/result.d.cts"
      },
      "import": "./dist/result.mjs",
      "require": "./dist/result.cjs",
      "default": "./dist/result.cjs"
    },
    "./isJson": {
      "types": {
        "import": "./dist/isJson.d.mts",
        "require": "./dist/isJson.d.cts",
        "default": "./dist/isJson.d.cts"
      },
      "import": "./dist/isJson.mjs",
      "require": "./dist/isJson.cjs",
      "default": "./dist/isJson.cjs"
    },
    "./parseBool": {
      "types": {
        "import": "./dist/parseBool.d.mts",
        "require": "./dist/parseBool.d.cts",
        "default": "./dist/parseBool.d.cts"
      },
      "import": "./dist/parseBool.mjs",
      "require": "./dist/parseBool.cjs",
      "default": "./dist/parseBool.cjs"
    },
    "./defaultsFor": {
      "types": {
        "import": "./dist/defaultsFor.d.mts",
        "require": "./dist/defaultsFor.d.cts",
        "default": "./dist/defaultsFor.d.cts"
      },
      "import": "./dist/defaultsFor.mjs",
      "require": "./dist/defaultsFor.cjs",
      "default": "./dist/defaultsFor.cjs"
    },
    "./withDefaults": {
      "types": {
        "import": "./dist/withDefaults.d.mts",
        "require": "./dist/withDefaults.d.cts",
        "default": "./dist/withDefaults.d.cts"
      },
      "import": "./dist/withDefaults.mjs",
      "require": "./dist/withDefaults.cjs",
      "default": "./dist/withDefaults.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "PROVENANCE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:runtime": "node --test test/public-contract.test.cjs && jest --runInBand",
    "test:types": "tsc -p test/tsconfig.json",
    "test": "yarn build && yarn test:runtime && yarn test:types",
    "validate": "yarn test",
    "prepack": "yarn build"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "yarn@4.6.0",
  "devDependencies": {
    "esbuild": "0.28.2",
    "jest": "29.7.0",
    "typescript": "6.0.3"
  }
}
